{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
       "env": {
        "EXPO_PUBLIC_API_URL": "https://fic-verse-backend.vercel.app/"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
       "env": {
        "EXPO_PUBLIC_API_URL": "https://fic-verse-backend.vercel.app/"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
       "env": {
        "EXPO_PUBLIC_API_URL": "https://fic-verse-backend.vercel.app/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
